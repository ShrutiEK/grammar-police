# Required for Sarvam speech transcription and conversation follow-ups.
SARVAM_API_KEY=
# Primary picture-metrics assessment and adaptive exercise generation.
OPENAI_API_KEY=
# Cross-provider fallback for picture-metrics assessment.
# Optional backup for adaptive exercise generation when OpenAI fails.
GEMINI_API_KEY=

# Durable learner-data store (Upstash Redis REST — https://console.upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# End-of-day snapshot store (MongoDB Atlas connection string + database name).
MONGODB_URI=
MONGODB_DB=grammar_police
# Shared secret for the daily EOD cron; Vercel Cron sends it as `Authorization: Bearer`.
CRON_SECRET=

# Canonical public origin used for SEO metadata, sitemap, robots, and social
# share previews. Optional — defaults to the production domain. Set this on
# preview/staging deployments so canonical + OpenGraph URLs point at the right host.
NEXT_PUBLIC_SITE_URL=
